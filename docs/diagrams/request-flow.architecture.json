  "cards": [
    {
      "dot": "cyan",
      "title": "Upload → pages",
      "items": [
        "Edge: 400 without X-Client-ID · 429 over 10 uploads/s",
        "Ingest: PDF → S3, then job + split outbox in one tx",
        "Splitter: one PDF per page, then pages + fast outbox"
      ]
    },
    {
      "dot": "emerald",
      "title": "Page route",
      "items": [
        "vf-fast → layout → FAST_COMPLETED + slow outbox",
        "vf-slow → VLM → COMPLETED + page event → stream",
        "GET /jobs/{id} and /result read Postgres (owner only)"
      ]
    },
    {
      "dot": "amber",
      "title": "Retries and failures",
      "items": [
        "429 → wait for Retry-After, no attempt used",
        "Timeout / 5xx → RETRY_WAIT + delayed outbox, 3 attempts",
        "Slow give-up → fast result (low_confidence) + DLQ",
        "Crash → message redelivered after 60 s"
      ]
    },
    {
      "dot": "slate",
      "title": "Beside the path",
      "items": [
        "S3: uploads, pages, results/{job}/pages/{idx}/…",
        "Redis: rate, concurrency, 10 s windows, breaker",
        "A deep slow queue throttles the fast stage"
      ]
    }
  ]
