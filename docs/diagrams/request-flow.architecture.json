{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "VisionForge request flow",
    "quality_profile": "showcase",
    "viewBox": [
      1390,
      560
    ],
    "views": [
      {
        "id": "upload-route",
        "label": "Upload → pages",
        "focus": [
          "client",
          "edge",
          "ingest",
          "postgres",
          "publisher",
          "sqs",
          "splitter"
        ],
        "note": "POST /jobs commits the job + a split outbox row; the publisher queues it; the splitter writes one page per row."
      },
      {
        "id": "page-route",
        "label": "Page processing",
        "focus": [
          "sqs",
          "fastw",
          "models",
          "sloww",
          "postgres",
          "publisher"
        ],
        "note": "Each page: vf-fast → layout → slow outbox → vf-slow → VLM → COMPLETED + page event."
      },
      {
        "id": "failure-routes",
        "label": "Retries and failures",
        "focus": [
          "fastw",
          "sloww",
          "models",
          "postgres",
          "publisher",
          "sqs",
          "dlq"
        ],
        "note": "Retries go back through the outbox with a delay; a slow give-up falls back to the fast result and is copied to the DLQ."
      },
      {
        "id": "stream-route",
        "label": "Streaming results",
        "focus": [
          "postgres",
          "stream",
          "edge",
          "client"
        ],
        "note": "Each committed page event NOTIFYs the gateway; clients resume with Last-Event-ID."
      },
      {
        "id": "read-route",
        "label": "Status and result reads",
        "focus": [
          "client",
          "edge",
          "ingest",
          "postgres"
        ],
        "note": "GET /jobs/{id} and /result read Postgres; another X-Client-ID gets 404."
      }
    ]
  },
