      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(vf_queue_wait_seconds_bucket[1m])))",
          "legendFormat": "wait p95 {{stage}}"
        },
        {
          "refId": "B",
          "expr": "max by (stage) (vf_queue_oldest_seconds)",
          "legendFormat": "oldest {{stage}}"
        }
      ]
